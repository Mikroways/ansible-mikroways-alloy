// {{ ansible_managed }}
// Logs de journald, filtrados en el agente desde {{ alloy_logs_min_priority }} para arriba.
// El label unit se normaliza (alloy_logs_journal_unit_rewrites) para no abrir
// un stream por cada login, systemd-run o contenedor.
loki.relabel "journal" {
  forward_to = []

  // Prioridad 0 (emerg) a {{ _alloy_priority_map[alloy_logs_min_priority] }} ({{ alloy_logs_min_priority }}). El resto se descarta.
  rule {
    source_labels = ["__journal_priority"]
    regex         = "[0-{{ _alloy_priority_map[alloy_logs_min_priority] }}]"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
{% for r in alloy_logs_journal_unit_rewrites %}

  rule {
    source_labels = ["unit"]
    regex         = {{ r.regex | to_json }}
    target_label  = "unit"
    replacement   = {{ r.replacement | to_json }}
  }
{% endfor %}

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "journal" {
  max_age       = {{ alloy_logs_journal_max_age | to_json }}
  relabel_rules = loki.relabel.journal.rules
  labels        = {"job" = "integrations/journal"}
  forward_to    = [loki.write.default.receiver]
}
