// {{ ansible_managed }}
// Métricas de host (node exporter integrado) y NTP (collector timex).
prometheus.exporter.unix "host" {
  set_collectors = {{ _alloy_collectors | to_json }}

  netdev {
    device_exclude = {{ alloy_netdev_device_exclude | to_json }}
  }

  textfile {
    directory = {{ alloy_textfile_directory | to_json }}
  }
{% if 'systemd' in _alloy_collectors %}

  // unit_include ya es la lista exacta. El unit_exclude por defecto descarta
  // .mount, .scope y otros tipos aunque estén pedidos: se apaga.
  systemd {
    unit_include    = {{ _alloy_units_regex | to_json }}
    unit_exclude    = "^$"
    enable_restarts = {{ alloy_systemd_restarts | bool | lower }}
  }
{% endif %}
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  scrape_interval = {{ alloy_scrape_interval | to_json }}
  forward_to      = [prometheus.relabel.host.receiver]
}

// De node_systemd_unit_state solo se guarda state="active" (0/1): alcanza
// para alertar "no está activa" sin multiplicar series por cinco.
prometheus.relabel "host" {
  forward_to = [prometheus.relabel.comun.receiver]

  rule {
    source_labels = ["__name__", "state"]
    regex         = "node_systemd_unit_state;(activating|deactivating|failed|inactive|maintenance|reloading|refreshing)"
    action        = "drop"
  }
}
