---
profile: production
exclude_paths:
  - .venv/
  - .ansible/
  - .github/
  - docs/
skip_list:
  # Los nombres de variables internas empiezan con _alloy_.
  - var-naming[no-role-prefix]
kinds:
  - tasks: "**/molecule/resources/verify-tasks.yml"
  - tasks: "**/tasks/**/*.yml"
# Action plugin del rol que usa tests/avisos-hijo.yml (fuera del rol,
# ansible-lint no la encuentra).
mock_modules:
  - mikroways_alloy_aviso
